	<queryString>
		<![CDATA[select (select nombre from producto where idProducto=productoventa.idProducto) as nombre, (select concat(nombre,' ',apPaterno,' ',apMaterno) from usuario where idUsuario=idVendedor) as name, (select precio from producto where idProducto=productoventa.idProducto) as costo, cantidad, subtotal, now() as fecha, cantRecibida, cambio from productoventa inner join venta on (productoventa.idVenta=venta.idVenta) WHERE productoventa.idVenta=(select max(idVenta) from venta WHERE idVendedor=(SELECT idUsuario from usuario WHERE usuario=$P{usuario}));]]>
	</queryString>
